          "settings": {
            "title": "Sodium Lauryl Sulfate (SLS): Why It Irritates Sensitive Skin"
          }
        },
        "byline": {
          "type": "byline",
          "settings": {
            "author": "exederm",
            "date": ""
          }
        },
        "spacer": {
