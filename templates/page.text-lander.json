        "title": {
          "type": "title",
          "settings": {
            "title": "Scalp Eczema: Causes, Symptoms, and How to Manage Flare-Ups"
          }
        },
        "byline": {
          "type": "byline",
          "settings": {
            "author": "exederm",
            "date": ""
          }
        },
        "spacer_Jd9frj": {
