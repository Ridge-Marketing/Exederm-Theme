<!-- /snippets/structured-data-product.liquid -->
{% comment %}
  Product + Offer JSON-LD — emitted on product templates only (gated in
  layout/theme.liquid on template.name == 'product'), using the global `product`.
  Every value is pulled from Shopify objects, so it stays correct as the catalog
  changes. Availability follows product.available (handles the out-of-stock SKUs).

  aggregateRating is intentionally OMITTED: Google forbids rating markup on a
  product with zero reviews, and Yotpo stores its bottomline as an HTML blob
  (product.metafields.yotpo.bottomline), not clean numeric rating/count fields, so
  there is no safe server-side value to merge. If ratings are wanted, either enable
  Yotpo's own rich-snippet feature (and then remove this block to keep one Product
  entity per page) or sync numeric Yotpo metafields and merge them conditionally.
{% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [{% for image in product.images limit: 3 %}"https:{{ image | img_url: '1024x' }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "brand": { "@type": "Brand", "name": "exederm" },
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "seller": { "@id": "{{ shop.url }}/#organization" }
  }
}
</script>
