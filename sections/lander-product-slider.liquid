{% comment %}
  Product-picker version of sections/product-slider.liquid. Same Swiper design,
  but the products are chosen individually via section blocks (product picker)
  instead of pulling a whole collection.
{% endcomment %}

<section id="{{ section.settings.anchor_id | default: 'more-products' }}" class="{{ section.settings.margins }} lproductSlider--{{ section.id }} " style="scroll-margin-top: 300px;">
  {% if section.settings.heading != blank %}
    <div class="tw-text-22px/28px xl:tw-max-w-1336px tw-mx-5 md:tw-mx-10 xl:tw-mx-auto tw-mb-7 tw-font-semibold tw-text-center tw-border-b tw-leading-em">
      <span class="tw-px-3 tw-bg-white">&nbsp;{{ section.settings.heading }}&nbsp;</span>
    </div>
  {% endif %}

  <div class="tw-flex tw-justify-center tw-mt-4 md:tw-px-10 tw-max-w-1336px tw-mx-auto">

    {% comment %} Count available picked products to decide whether arrows show on desktop. {% endcomment %}
    {% assign available_count = 0 %}
    {% for block in section.blocks %}
      {% assign picked = all_products[block.settings.product] %}
      {% if picked != blank %}
        {% assign available_count = available_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    <!-- Scroll button for swiper -->
    <div class="button-prev--products-{{ section.id }} tw-mx-6 tw-self-center tw-cursor-pointer {% if available_count <= 4 %}lg:tw-hidden{% endif %}">
      <svg class="tw-w-8" role="img" aria-label="View previous item in slider" width="23" height="38" viewBox="0 0 23 38" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0.439453 17.7832L17.666 0.439453C18.1348 -0.146484 19.0723 -0.146484 19.6582 0.439453L21.8848 2.7832C22.4707 3.25195 22.4707 4.18945 21.8848 4.77539L8.05664 18.7207L21.8848 32.7832C22.4707 33.3691 22.4707 34.1895 21.8848 34.7754L19.6582 37.1191C19.0723 37.7051 18.1348 37.7051 17.666 37.1191L0.439453 19.7754C-0.146484 19.1895 -0.146484 18.3691 0.439453 17.7832Z" fill="#3E9A76"/>
      </svg>
    </div>

    <!-- Slideshow of products -->
    <div style="padding-top: 1rem;" class="swiper-container swiper-container--products-{{ section.id }} tw-flex-grow-0 tw-w-full xl:tw-max-w-1336px tw-mt-4 tw-pt-4">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% assign product = all_products[block.settings.product] %}
          {% if product != blank %}
            {% include 'lander-product-card' %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Scroll button for swiper -->
    <div class="button-next--products-{{ section.id }} tw-mx-6 tw-self-center tw-cursor-pointer {% if available_count <= 4 %}lg:tw-hidden{% endif %}">
      <svg class="tw-w-8" style="transform: scaleX(-1);" role="img" aria-label="View next item in slider" width="23" height="38" viewBox="0 0 23 38" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0.439453 17.7832L17.666 0.439453C18.1348 -0.146484 19.0723 -0.146484 19.6582 0.439453L21.8848 2.7832C22.4707 3.25195 22.4707 4.18945 21.8848 4.77539L8.05664 18.7207L21.8848 32.7832C22.4707 33.3691 22.4707 34.1895 21.8848 34.7754L19.6582 37.1191C19.0723 37.7051 18.1348 37.7051 17.666 37.1191L0.439453 19.7754C-0.146484 19.1895 -0.146484 18.3691 0.439453 17.7832Z" fill="#3E9A76"/>
      </svg>
    </div>
  </div>

  {% if section.settings.use_button %}
    <div class="tw-mt-8 tw-text-center">
      <a href="{{ section.settings.button_link }}" class="tw-w-48 tw-text-center primary__button tw-py-3">{{ section.settings.button_text }}</a>
    </div>
  {% endif %}
</section>

<script src="https://unpkg.com/swiper@6.8.2/swiper-bundle.js"></script>
<script src="https://unpkg.com/swiper@6.8.2/swiper-bundle.min.js"></script>

<script>
  new Swiper('.swiper-container--products-{{ section.id }}', {
    spaceBetween: 5,
    speed: 1500,
    loop: false,
    breakpoints: {
      768: {
        slidesPerView: 2,
        slidesPerGroup: 1,
      },
      1024: {
        slidesPerView: 4,
        slidesPerGroup: 1
      }
    },
    fadeEffect: {
      crossFade: false,
    },
    navigation: {
      nextEl: ".button-next--products-{{ section.id }}",
      prevEl: ".button-prev--products-{{ section.id }}",
    },
  });
</script>

<style>
  @media screen and (min-width:1024px){
    .lproductSlider--{{ section.id }}{
      margin-bottom:150px;
    }
  }
</style>

{% schema %}
  {
    "name": "Product Slider (Picker)",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Product list title",
        "default": "More Eczema Products"
      },
      {
        "type": "text",
        "id": "anchor_id",
        "label": "Anchor ID (for sticky nav links)",
        "default": "more-products"
      },
      {
        "type": "text",
        "id": "margins",
        "label": "Margin Class"
      },
      {
        "id": "use_button",
        "type": "checkbox",
        "label": "Use Button"
      },
      {
        "id": "button_text",
        "type": "text",
        "label": "Button text"
      },
      {
        "id": "button_link",
        "type": "url",
        "label": "Button link"
      }
    ],
    "blocks": [
      {
        "type": "product",
        "name": "Product",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Slider (Picker)",
        "category": "Product page",
        "blocks": [
          { "type": "product" },
          { "type": "product" },
          { "type": "product" },
          { "type": "product" }
        ]
      }
    ]
  }
{% endschema %}
