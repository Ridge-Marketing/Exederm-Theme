{% comment %}
  FAQ accordion — Figma node 2095-1213.
  Green heading + white rounded, drop-shadowed cards with a green +/- toggle.
  Built on <details>/<summary> so it works without JS and stays accessible.
  Styling is scoped CSS (the theme's compiled Tailwind is purged/prebuilt, so new
  utility combos can't be relied on). Each Q&A is an editable block.
{% endcomment %}

{% comment %} FAQs come from either editable blocks (default — e.g. the Hydrocortisone Lander) or a
  product metafield list of FAQ metaobjects (custom.faqs) on generic product templates. Each FAQ
  metaobject has `question` (text) and `answer` (multi-line text) field handles. {% endcomment %}
{% assign faq_entries = product.metafields.custom.faqs.value %}
{% if section.settings.faq_source == 'metafield' and faq_entries == blank %}
  {% comment %} Metafield-driven but this product has no FAQs set — render nothing. {% endcomment %}
{% else %}
<section id="{{ section.settings.anchor_id | default: 'faqs' }}" class="lfaq lfaq--{{ section.id }} tw-container xl:tw-max-w-1336px">
  <hr/>

  {% if section.settings.heading != blank %}
    <h2 class="lfaq__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="lfaq__list">
    {% if section.settings.faq_source == 'metafield' %}
      {% for entry in faq_entries %}
        <details class="lfaq__item" {% if forloop.first %}open{% endif %}>
          <summary class="lfaq__summary">
            <span class="lfaq__q">{{ entry.question }}</span>
            <span class="lfaq__icon" aria-hidden="true"></span>
          </summary>
          <div class="lfaq__answer rte">{{ entry.answer | newline_to_br }}</div>
        </details>
      {% endfor %}
    {% else %}
      {% for block in section.blocks %}
        <details class="lfaq__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="lfaq__summary">
            <span class="lfaq__q">{{ block.settings.question }}</span>
            <span class="lfaq__icon" aria-hidden="true"></span>
          </summary>
          <div class="lfaq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    {% endif %}
  </div>
</section>
{% endif %}

<style>
  .lfaq--{{ section.id }} hr {
    border-top:#F4FAFC 5px solid;
    margin-bottom:80px;
  }
  .lfaq--{{ section.id }} {
    {% comment %} max-width: 1336px; {% endcomment %}
    {% comment %} margin: 48px auto; {% endcomment %}
    margin: 0 auto;
    padding: 0 20px;
    margin-top:80px;
    scroll-margin-top: 300px;
  }
  .lfaq--{{ section.id }} .lfaq__heading, 
  .lfaq--{{ section.id }} h2 {
    font-family: 'Encode Sans', sans-serif;
    font-weight: 500;
    font-size: 22px;
    line-height: 28px;
    color: #3e9a76;
    margin-bottom: 24px !important;
  }
  .lfaq--{{ section.id }} .lfaq__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .lfaq--{{ section.id }} .lfaq__item {
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 2px 4.5px rgba(0, 0, 0, 0.19);
    padding: 22px 18px 24px;
  }
  .lfaq--{{ section.id }} .lfaq__summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    cursor: pointer;
    list-style: none;
  }
  .lfaq--{{ section.id }} .lfaq__summary::-webkit-details-marker { display: none; }
  .lfaq--{{ section.id }} .lfaq__q {
    font-family: 'Encode Sans', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 26px;
    color: #000;
  }
  .lfaq--{{ section.id }} .lfaq__icon {
    flex-shrink: 0;
    font-family: 'Open Sans', sans-serif;
    font-size: 30px;
    line-height: 1;
    color: #3e9a76;
  }
  .lfaq--{{ section.id }} .lfaq__icon::after { content: "+"; }
  .lfaq--{{ section.id }} .lfaq__item[open] .lfaq__icon::after { content: "\2212"; } /* minus */
  .lfaq--{{ section.id }} .lfaq__answer {
    font-family: 'Open Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #000;
    margin-top: 16px;
  }
  .lfaq--{{ section.id }} .lfaq__answer p { margin: 0 0 10px; }
  @media (min-width: 768px) {
    {% comment %} .lfaq--{{ section.id }} { margin: 64px auto; } {% endcomment %}
    .lfaq--{{ section.id }} {
      margin-bottom:120px;
    }
    .lfaq--{{ section.id }} .lfaq__q { font-size: 25px; line-height: 32px; }

  }
</style>

{% schema %}
  {
    "name": "FAQ Accordion",
    "settings": [
      {
        "type": "select",
        "id": "faq_source",
        "label": "FAQ source",
        "info": "Blocks: use the editable questions below (Hydrocortisone Lander). Product metafield: pull each product's custom.faqs (list of FAQ metaobjects).",
        "options": [
          { "value": "blocks", "label": "Blocks (editable below)" },
          { "value": "metafield", "label": "Product metafield: FAQs (custom.faqs)" }
        ],
        "default": "blocks"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Frequently Asked Questions"
      },
      {
        "type": "text",
        "id": "anchor_id",
        "label": "Anchor ID (for sticky nav links)",
        "default": "faqs"
      }
    ],
    "blocks": [
      {
        "type": "faq",
        "name": "Question",
        "settings": [
          { "type": "text", "id": "question", "label": "Question" },
          { "type": "richtext", "id": "answer", "label": "Answer" },
          { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ Accordion",
        "category": "Hydrocortisone Lander"
      }
    ]
  }
{% endschema %}
