{% comment %}
  Lander reviews — the same Yotpo main widget used on the product page
  (sections/product-indv-reviews.liquid). On a product template it uses the current
  `product`; on a page template it resolves the product referenced by the page's
  `custom.hydrocortisone_lander` metaobject. Anchored with id="reviews".
{% endcomment %}

{% assign lander_product = page.metafields.custom.hydrocortisone_lander.value.product.value %}
{% if lander_product %}
  {% assign product = lander_product %}
{% endif %}

{% if product %}
  <div id="reviews" class="lreviews--{{ section.id }} main-content tw-container tw-mx-auto tw-px-5 xl:tw-max-w-1336px" style="scroll-margin-top: 300px;">

  <div class="lreviews__head xl:tw-max-w-1336px xl:tw-mx-auto tw-mb-7">
      <span class="lreviews__title tw-text-22px/28px tw-font-semibold tw-bg-white tw-relative tw-w-full">
        <span class="tw-relative tw-bg-white" style="">Reviews</span>
        <div aria-hidden="true" style="position:absolute; left:0; right:0; top:50%; height:1px; background:#e5e7eb; z-index:0"></div>
      </span>
      <button
        type="button"
        class="lreviews__cta primary__button tw-w-48 tw-py-3"
        onclick="var b = document.getElementById('yotpo-main-widget-btn'); if (b) { b.click(); }">Write A Review</button>
  </div>

    <div class="">
      {% comment %} <div class="yotpo yotpo-main-widget"
        data-product-id="{{ product.id }}"
        data-name="{{ product.title | escape }}"
        data-url="{{ shop.url }}{{ product.url }}"
        data-image-url="{{ product.featured_image | product_img_url: 'large' | replace: '?', '%3F' | replace: '&','%26' }}"
        data-description="{{ product.description | escape }}">
      </div> {% endcomment %}
      <div class="yotpo-widget-instance" data-yotpo-instance-id="1033053" data-yotpo-product-id="{{product.id}}" data-yotpo-name="{{ product.title | escape }}" data-yotpo-url="{{ shop.url }}{{ product.url }}" data-yotpo-image-url="{{ product.featured_image | product_img_url: "large" | prepend: "https:" | replace: '?', '%3F' | replace: '&','%26'}}" data-yotpo-price="{{ product.price | divided_by: 100.00 }}" data-yotpo-currency="{{ shop.currency }}" data-yotpo-description="{{ product.description | escape }}"></div>
    </div>
  </div>

<style>
  .lreviews--{{ section.id }} .yotpo-reviews-pagination-container{
      margin-bottom:0;
  }
  .lreviews--{{ section.id }} .yotpo-head{
      display:none!important;
  }
  .lreviews--{{ section.id }} .yotpo-base-layout{
      width:100%!important;
  }
  .lreviews--{{ section.id }} .yotpo-layout-header-wrapper{
     justify-content:start !important;
  }
  .lreviews--{{ section.id }} #yotpo-main-widget-btn{
      display:none!important;
  }
  /* "Reviews ———— [Write A Review]" heading: gray rule runs through the
     vertical center of both the label and the button (button's own solid
     green knocks the line out behind it). Button sits at the far right. */
  .lreviews--{{ section.id }} .lreviews__head{
     display:flex;
     align-items:center;
     justify-content:space-between;
     gap:16px;
     background:linear-gradient(#e5e7eb,#e5e7eb) left center / 100% 1px no-repeat;
  }
  .lreviews--{{ section.id }} .lreviews__head span span{
      z-index:1; 
      padding-right:25px; 
      text-align: left; 
      position: relative;
      display: block; 
      width: max-content;
  }
  @media screen and (max-width:450px) {
    .lreviews--{{ section.id }} .lreviews__head span span{
      padding: 25px; 
      text-align: center; 
      margin: auto;
    }
    .lreviews--{{ section.id }} .lreviews__head{
      flex-direction:column;
      background:none;
    }
  }
  .lreviews--{{ section.id }} .lreviews__title{
     padding-right:12px;
  }
  .lreviews--{{ section.id }} .lreviews__cta{
     flex-shrink:0;
     position:relative;
  }
  .lreviews--{{ section.id }} .lreviews__cta:before {
    content:'';
    background:white;
    top:0;
    left:-11%;
    width:10%;
    height:100%;
    position:absolute;
    z-index:0
  }
  .yotpo-vertical-pagination button{
    padding-bottom: 5px;
  }
  html .lreviews--{{ section.id }} .yotpo-star-distribution {
    {% comment %} padding: 0; {% endcomment %}
    margin: 0;
  }
  @media screen and (max-width:768px) {
     html .lreviews--{{ section.id }} .yotpo-vertical-border {
      display:none!important;
    }
     html .lreviews--{{ section.id }} .yotpo-star-distribution {
      border-right:0px!important;
    }
  } 
</style>


{% endif %}

{% schema %}
  {
    "name": "Lander: Reviews",
    "settings": [],
    "presets": [
      {
        "name": "Lander: Reviews",
        "category": "Hydrocortisone Lander"
      }
    ]
  }
{% endschema %}
