{% comment %}
  Sticky sub-nav + content rows — Figma node 2127-1000 ("Tabs").

  - The sticky bar auto-builds a pill link for every block (both "content" and
    "nav_link" types), in order, using each block's nav_label + anchor_id.
  - "content" blocks additionally render a text / image / checklist row anchored
    by their anchor_id (Our Ingredients, About Hydrocortisone, Why exederm).
  - "nav_link" blocks are link-only — they point at OTHER sections further down
    the page (e.g. #more-products, #reviews, #faqs).
  - A small IntersectionObserver highlights the pill for the section in view.

  Styling is scoped CSS: the theme's compiled Tailwind is purged/prebuilt, so new
  responsive utility combos can't be relied on.
{% endcomment %}

<div class="ltabs ltabs--{{ section.id }}">

  <div class="ltabs__sentinel" aria-hidden="true"></div>
  <nav class="ltabs__nav" aria-label="Section navigation">
    <div class="ltabs__nav-inner">
      {% for block in section.blocks %}
        {% if block.settings.anchor_id != blank and block.settings.nav_label != blank %}
          <a href="#{{ block.settings.anchor_id }}" data-target="{{ block.settings.anchor_id }}" class="ltabs__link" {{ block.shopify_attributes }}>{{ block.settings.nav_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </nav>

  <div class="ltabs__body">
    {% for block in section.blocks %}
      {% if block.type == 'content' %}
        {% comment %} Image is normally the image picker; optionally a product metafield image
          (why_exederm_image) so the same section works on generic product templates. Handles
          both file_reference (.value.image) and image_reference (.value) metafield types. {% endcomment %}
        {% assign mf_image = blank %}
        {% assign mf_image_mobile = blank %}
        {% if block.settings.image_source == 'why_exederm_image' %}
          {% assign mf_image = product.metafields.custom.why_exederm_image.value %}
          {% if mf_image.image %}{% assign mf_image = mf_image.image %}{% endif %}
          {% assign mf_image_mobile = product.metafields.custom.why_exederm_image_mobile.value %}
          {% if mf_image_mobile.image %}{% assign mf_image_mobile = mf_image_mobile.image %}{% endif %}
        {% endif %}
        {% comment %} Desktop image, falling back to the mobile image if only that is set. {% endcomment %}
        {% assign row_image = mf_image | default: mf_image_mobile | default: block.settings.image | default: block.settings.mobile_image %}
        <div id="{{ block.settings.anchor_id }}" class="ltabs__row{% if block.settings.image_position == 'left' %} ltabs__row--img-left{% endif %}{% if row_image == blank %} ltabs__row--no-img{% endif %}" {{ block.shopify_attributes }}>
          <div class="ltabs__text">
            {% if block.settings.eyebrow != blank %}<p class="ltabs__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
            {% if block.settings.heading != blank %}<h2 class="ltabs__title">{{ block.settings.heading }}</h2>{% endif %}
            {% comment %} Body is normally the manual richtext; optionally sourced from a product
              metafield so the same section works on generic product templates. {% endcomment %}
            {% case block.settings.body_source %}
              {% when 'our_ingredients' %}
                {% assign row_body = product.metafields.custom.our_ingredients | metafield_tag %}
              {% when 'why_exederm' %}
                {% assign row_body = product.metafields.custom.why_exederm | metafield_tag %}
              {% else %}
                {% assign row_body = block.settings.body %}
            {% endcase %}
            <div class="ltabs__rte rte">{{ row_body }}</div>

            {% if block.settings.checklist != blank or block.settings.checklist_2 != blank %}
              <div class="ltabs__checks">
                {% if block.settings.checklist != blank %}<div class="ltabs__check-col">{{ block.settings.checklist }}</div>{% endif %}
                {% if block.settings.checklist_2 != blank %}<div class="ltabs__check-col">{{ block.settings.checklist_2 }}</div>{% endif %}
              </div>
            {% endif %}
          </div>

          {% if row_image != blank %}
            <div class="ltabs__media">
              <picture>
                {% if mf_image_mobile != blank %}
                  <source media="(max-width: 1023px)" srcset="{{ mf_image_mobile | image_url: width: 800 }}">
                {% elsif mf_image == blank and block.settings.mobile_image != blank %}
                  <source media="(max-width: 1023px)" srcset="{{ block.settings.mobile_image | image_url: width: 800 }}">
                {% endif %}
                <img
                  src="{{ row_image | image_url: width: 616 }}"
                  alt="{{ row_image.alt | escape }}"
                  loading="lazy"
                  width="{{ row_image.width }}"
                  height="{{ row_image.height }}">
              </picture>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .ltabs--{{ section.id }} .ltabs__nav {
    position: sticky;
    top: 84px;
    z-index: 30;
    background: #f4fafc;
    padding: 16px 0;
  }
  /* Pinned page-wide (toggled by JS) so the nav escapes its section wrapper
     and keeps sticking through the sections below. */
  .ltabs--{{ section.id }} .ltabs__nav.is-fixed {
    position: fixed;
    top: 84px;
    left: 0;
    right: 0;
    z-index: 40;
  }
  .ltabs--{{ section.id }} .ltabs__nav-inner {
    max-width: 1336px;
    margin: 0 auto;
    padding: 40px 16px;
    display: flex;
    gap: 14px;
    justify-content: flex-start;
    overflow-x: auto;
  }
  .ltabs--{{ section.id }} .ltabs__link {
    white-space: nowrap;
    background: #fff;
    border: 3px solid transparent;
    border-radius: 10px;
    box-shadow: 0 2px 9px rgba(0, 0, 0, 0.19);
    padding: 12px 20px;
    font-family: 'Encode Sans', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 22px;
    color: #3e9a76;
    text-decoration: none;
  }
  .ltabs--{{ section.id }} .ltabs__link.is-active { border-color: #3e9a76; }

  .ltabs--{{ section.id }} .ltabs__body {
    max-width: 1336px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ltabs--{{ section.id }} .ltabs__row {
    padding: 40px 0;
    scroll-margin-top: 300px;
    border-bottom: #F4FAFC 5px solid;
  }
  .ltabs--{{ section.id }} .ltabs__row:last-of-type {
    border-bottom:0px;
    padding-bottom:150px;
  }
  .ltabs--{{ section.id }} .ltabs__eyebrow {
    font-family: 'Encode Sans', sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 24px;
    color: #3e9a76;
    margin: 0 0 16px;
  }
  html .ltabs--{{ section.id }} .ltabs__title {
    font-family: 'Encode Sans', sans-serif;
    font-weight: 400;
    font-size: 26px;
    line-height: 33px;
    color: #000;
    margin: 0 10px 16px 0 !important;
  }

  @media screen and (min-width:1024px) {
    html .ltabs--{{ section.id }} .ltabs__title {
        text-wrap: balance;
    }
  }
  .ltabs--{{ section.id }} .ltabs__rte,
  .ltabs--{{ section.id }} .ltabs__check-col {
    font-family: 'Open Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #000;
  }
  .ltabs--{{ section.id }} .ltabs__rte p { margin: 0 0 10px; }
  .ltabs--{{ section.id }} .ltabs__checks { margin-top: 24px; display: flex; flex-direction:row; gap: 12px 48px; }
  @media screen and (max-width:540px) {
    .ltabs--{{ section.id }} .ltabs__checks {
      flex-wrap:wrap;
      flex-direction:column;
      gap:0px;
    }
  }
  .ltabs--{{ section.id }} .ltabs__checks ul { list-style: none; margin: 0; padding: 0; }
  .ltabs--{{ section.id }} .ltabs__checks li { position: relative; padding-left: 30px; margin-bottom: 10px; }
  .ltabs--{{ section.id }} .ltabs__checks li::before {
    content: "\f00c"; /* fa-check */
    font-family: FontAwesome;
    position: absolute; left: 0; top: 1px;
    color: #3e9a76;
  }
  .ltabs--{{ section.id }} .ltabs__media { margin-top: 24px; }
  .ltabs--{{ section.id }} .ltabs__media img { width: 100%; height: auto; border-radius: 0px; object-fit: cover; }

  @media (min-width: 768px) {
    /* `safe center` keeps the pills centered when they fit, but falls back to
       start-alignment when they overflow so the FIRST pill stays reachable by
       scrolling (plain `center` clips it off the left with no way to scroll to
       it). Browsers without `safe` ignore this and keep the base flex-start. */
    .ltabs--{{ section.id }} .ltabs__nav-inner { justify-content: safe center; }
    .ltabs--{{ section.id }} .ltabs__link { font-size: 18px; line-height: 24px; }
    .ltabs--{{ section.id }} .ltabs__body { padding: 0 40px; }
  }
  @media (min-width: 1024px) {
    .ltabs--{{ section.id }} .ltabs__row { 
      display: flex; 
      gap: 40px; 
      align-items: flex-start; 
      padding: 80px 0; 
      max-width:1176px;
      margin:auto;
    }
    .ltabs--{{ section.id }} .ltabs__row--img-left { flex-direction: row-reverse; }
    .ltabs--{{ section.id }} .ltabs__row--no-img { display: block; }
    .ltabs--{{ section.id }} .ltabs__text { flex: 0 0 66%; max-width: 66%; }
    .ltabs--{{ section.id }} .ltabs__row--no-img .ltabs__text { max-width: 100%; }
    .ltabs--{{ section.id }} .ltabs__media { flex: 0 0 30%; margin-top: 0; }
    .ltabs--{{ section.id }} .ltabs__title { font-size: 30px; line-height: 38px; }
  }
</style>

<script>
  function stickyNav() {
    var root = document.querySelector('.ltabs--{{ section.id }}');
    if (!root) return;
    var links = [].slice.call(root.querySelectorAll('.ltabs__link'));
    if (!('IntersectionObserver' in window) || !links.length) return;

    function linkFor(id) { return root.querySelector('.ltabs__link[data-target="' + id + '"]'); }

    // On mobile the pills overflow and scroll horizontally — keep the active
    // pill centered in view. No-ops on desktop where the row isn't scrollable.
    var navInner = root.querySelector('.ltabs__nav-inner');
    function scrollActiveIntoView(link) {
      if (!navInner || navInner.scrollWidth <= navInner.clientWidth) return;
      var cRect = navInner.getBoundingClientRect();
      var lRect = link.getBoundingClientRect();
      var delta = (lRect.left - cRect.left) - (cRect.width - lRect.width) / 2;
      navInner.scrollTo({ left: navInner.scrollLeft + delta, behavior: 'smooth' });
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var link = linkFor(entry.target.id);
        if (!link) return;
        links.forEach(function (l) { l.classList.remove('is-active'); });
        link.classList.add('is-active');
        scrollActiveIntoView(link);
      });
    }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });

    // Observe every target a nav pill points at (in-section rows + external sections).
    links.forEach(function (link) {
      var target = document.getElementById(link.getAttribute('data-target'));
      if (target) observer.observe(target);
    });

    // --- Keep the nav pinned across the WHOLE page ---------------------------
    var nav = root.querySelector('.ltabs__nav');
    var sentinel = root.querySelector('.ltabs__sentinel');
    if (nav && sentinel) {
      var PIN_TOP = 84; // must match .ltabs__nav `top`
      var spacer = document.createElement('div');
      spacer.style.display = 'none';
      nav.parentNode.insertBefore(spacer, nav);

      function setPinned(on) {
        if (on === nav.classList.contains('is-fixed')) return;
        if (on) {
          spacer.style.height = nav.offsetHeight + 'px';
          spacer.style.display = 'block';
          nav.classList.add('is-fixed');
        } else {
          nav.classList.remove('is-fixed');
          spacer.style.display = 'none';
        }
      }

      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          setPinned(sentinel.getBoundingClientRect().top <= PIN_TOP);
          ticking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', function () {
        if (nav.classList.contains('is-fixed')) spacer.style.height = nav.offsetHeight + 'px';
        onScroll();
      });
      onScroll();
    }
  }
  // Wait until the whole document is parsed so the sections BELOW this one
  // (#more-products, #reviews, #faqs) exist before we query them.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', stickyNav);
  } else {
    stickyNav();
  }
  // Re-run when this section is (re)loaded in the theme editor.
  document.addEventListener('shopify:section:load', function () { stickyNav(); });
</script>

{% schema %}
  {
    "name": "Sticky Nav + Content",
    "settings": [],
    "blocks": [
      {
        "type": "content",
        "name": "Content section",
        "settings": [
          { "type": "text", "id": "nav_label", "label": "Nav label" },
          { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Unique, lowercase, no spaces. The nav pill scrolls here." },
          { "type": "text", "id": "eyebrow", "label": "Eyebrow (green label)" },
          { "type": "text", "id": "heading", "label": "Heading" },
          {
            "type": "select",
            "id": "body_source",
            "label": "Body source",
            "info": "Where the body copy comes from. Use a product metafield on generic product templates; leave Manual on the Hydrocortisone Lander.",
            "options": [
              { "value": "manual", "label": "Manual (use Body below)" },
              { "value": "our_ingredients", "label": "Product metafield: Our Ingredients" },
              { "value": "why_exederm", "label": "Product metafield: Why Exederm" }
            ],
            "default": "manual"
          },
          { "type": "richtext", "id": "body", "label": "Body" },
          { "type": "header", "content": "Checklist (bullet lists = green checks)" },
          { "type": "richtext", "id": "checklist", "label": "Checklist column 1" },
          { "type": "richtext", "id": "checklist_2", "label": "Checklist column 2 (optional)" },
          { "type": "header", "content": "Image" },
          {
            "type": "select",
            "id": "image_source",
            "label": "Image source",
            "info": "Use a product metafield image on generic product templates; leave Manual on the Hydrocortisone Lander.",
            "options": [
              { "value": "manual", "label": "Manual (use Image below)" },
              { "value": "why_exederm_image", "label": "Product metafield: Why Exederm Image" }
            ],
            "default": "manual"
          },
          { "type": "image_picker", "id": "image", "label": "Image" },
          { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)", "info": "Shown below 768px. Falls back to the image above if empty." },
          {
            "type": "select",
            "id": "image_position",
            "label": "Image position",
            "options": [
              { "value": "right", "label": "Right" },
              { "value": "left", "label": "Left" }
            ],
            "default": "right"
          }
        ]
      },
      {
        "type": "nav_link",
        "name": "Nav link (jump to)",
        "settings": [
          { "type": "text", "id": "nav_label", "label": "Nav label" },
          { "type": "text", "id": "anchor_id", "label": "Target anchor ID", "info": "The anchor ID of a section elsewhere on the page (e.g. more-products, reviews, faqs)." }
        ]
      }
    ],
    "presets": [
      {
        "name": "Sticky Nav + Content",
        "category": "Hydrocortisone Lander"
      }
    ]
  }
{% endschema %}
