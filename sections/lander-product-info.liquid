{% comment %}
  Lander hero — resolves the product referenced by the page's
  `custom.hydrocortisone_lander` metaobject, then renders the exact same product
  block used on the default product template (snippets/product-indv-info-block).
  `product` and `section` are inherited by the include through shared scope.
{% endcomment %}

{% assign lander  = page.metafields.custom.hydrocortisone_lander.value %}
{% assign product = lander.product.value %}

{% if product %}
  {% include 'product-indv-info-block' %}
{% else %}
  <div class="tw-container tw-mx-auto tw-px-5 tw-py-10 tw-text-center">
    <p class="tw-text-gray-400">Link a product to this page via the <strong>Hydrocortisone Lander</strong> metaobject to display the product block.</p>
  </div>
{% endif %}

{% schema %}
  {
    "name": "Lander: Product Info",
    "settings": [
      {
        "id": "title_override",
        "type": "text",
        "label": "Title Override"
      },
      {
        "id": "description_override",
        "type": "richtext",
        "label": "Description Override",
        "info": "Replaces the product description in the hero block. Leave empty to use the product's own description."
      }
    ],
    "presets": [
      {
        "name": "Lander: Product Info",
        "category": "Hydrocortisone Lander"
      }
    ]
  }
{% endschema %}
