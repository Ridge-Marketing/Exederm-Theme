{% if section.settings.text != 'None' %}
<div class="tw-mt-7 tw-w-full tw-px-2 md:tw-px-9 xl:tw-px-72 tw-mb-16 tw-text-center tw-hidden">
  <div class="tw-mb-10">
      <img class="tw-mx-auto" src="https://cdn.shopify.com/s/files/1/1211/7332/files/nea-badge.jpg?11679574105445620494" alt="The badge of the National Eczema Association">
  </div>
  <p class="tw-text-16px/24px tw-font-normal tw-font-open-sans tw-text-black">
      {{ section.settings.text}}
  </p>
  <br>
  {% comment %}
  <i class="fa fa-star"></i>&nbsp;<i class="fa fa-star"></i>&nbsp;<i class="fa fa-star"></i>&nbsp;<i class="fa fa-star"></i>&nbsp;<i class="fa fa-star"></i>&nbsp;
  {% endcomment %}
  <br>

  <a href="/pages/faqs" class="tw-text-green hover:tw-text-hover-green tw-font-open-sans tw-text-16px/22px tw-font-bold tw-underline">Learn More</a>

  </div>
  {% endif %}

  <div class="clearfix"></div>   
  <meta name="google-site-verification" content="kiT8g3axdU1-CT-LemF5yUPAK2DgyB28byufYmpvlhA" />


  {% comment %} tw-px-5 md:tw-px-10 {% endcomment %}
  <div style="padding:20px;" class="lslider--{{ section.id }} tw-mt-16 tw-container xl:tw-max-w-1336px tw-mx-auto tw-mb-7 tw-w-full tw-text-center tw-mx-auto">

    <div style="position:relative;" class="tw-text-22px/28px tw-mb-16 tw-font-semibold tw-text-center tw-leading-em">
        <div aria-hidden="true" style="position:absolute; left:0; right:0; top:50%; height:1px; background:#e5e7eb;"></div>
        <span style="position:relative; line-height:2rem;" class="lslider__title tw-px-3 tw-bg-white tw-inline-block">Available at These Fine Retailers:</span>
    </div>

      <div class="tw-flex tw-justify-center tw-mt-4">

        <!-- Scroll button for swiper -->
        <div class="button-prev--logo tw-mx-6 tw-self-center">
          <img class="tw-w-72 lg:tw-w-48 xl:tw-w-32" src="https://cdn.shopify.com/s/files/1/0561/8571/6895/files/arrow-retailer-left.svg?v=1682691853" alt="View previous item in slider">
        </div>
        
        <!-- Slideshow of retailers -->
        <div class="swiper-container swiper-container--{{ section.id }} tw-flex-grow-0">
          
          <div class="swiper-wrapper">

            <!-- Loop through CMS content for slides -->
            {% for retailer in shop.metaobjects.retail_slider.values %}
              {% for logo in retailer.retailer_logos.value %}
                <div class="swiper-slide tw-flex tw-items-center tw-justify-center">
                  <img src="{{ logo | image_url }}" alt="{{ logo.alt | default: 'Retailer logo' | escape }}" />
                </div>
              {% endfor %}
            {% endfor %}
          </div>
        
        </div>

        <!-- Scroll button for swiper -->
          <div class="button-next--logo tw-mx-6 tw-self-center">
            <img class="tw-w-72 lg:tw-w-48 xl:tw-w-32" src="https://cdn.shopify.com/s/files/1/0561/8571/6895/files/arrow-retailer-right.svg?v=1682691853" alt="View next item in slider">
          </div>
      </div>
  </div>
      <br/>
      <br/>
</div>

<script src="https://unpkg.com/swiper@6.8.2/swiper-bundle.js"></script>
<script src="https://unpkg.com/swiper@6.8.2/swiper-bundle.min.js"></script>

<script>
    const swiper = new Swiper('.swiper-container--{{ section.id }}', {
        spaceBetween: 30,
        speed: 2500,
        loop: true, 
        breakpoints: {
          768: {
            slidesPerView: 2,
            slidesPerGroup: 2,
          },
          1024: {
            slidesPerView: 3,
            slidesPerGroup: 3
          },
          1280: {
            slidesPerView: 4,
            slidesPerGroup: 4
          },
          1536: {
            slidesPerView: 5,
            slidesPerGroup: 5
          }
        },
        autoplay: {
            delay: 2500,
            disableOnInteraction: true,
        },
        fadeEffect: {
            crossFade: false,
        },
        navigation: {
          nextEl: ".button-next--logo",
          prevEl: ".button-prev--logo",
        },
      });
  </script>


  <style>
    /* Keep the heading text within 75% on small screens so it wraps and the
       centered rule stays visible on both sides; full width from 768px up. */
    .lslider--{{ section.id }} .lslider__title { max-width: 75%; }
    @media screen and (min-width:768px){
      .lslider--{{ section.id }} .lslider__title { max-width: none; }
    }
    @media screen and (min-width:1024px){
      .lslider--{{ section.id }}{
          margin-bottom:120px;
      }
    }
  </style>

{% schema %}
  {
    "name": "Logo Slider Section",
    "settings": [],
    "presets": [
      {
        "name": "Logo Slider",
        "category": "Home page"
      }
    ]
  }
{% endschema %}